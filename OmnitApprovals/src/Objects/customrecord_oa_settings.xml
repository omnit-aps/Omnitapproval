<?xml version="1.0" encoding="UTF-8"?>
<customrecordtype scriptid="customrecord_oa_settings">
  <recordname>OA - Approval Settings</recordname>
  <isinactive>F</isinactive>
  <allowattachments>F</allowattachments>
  <allowinlineediting>F</allowinlineediting>
  <allowquickadd>F</allowquickadd>
  <isordered>F</isordered>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_oa_subsidiary">
      <label>Subsidiary</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-117</selectrecordtype>
      <ismandatory>T</ismandatory>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_enable_po">
      <label>Enable PO Approval</label>
      <fieldtype>CHECKBOX</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_enable_vb">
      <label>Enable VB Approval</label>
      <fieldtype>CHECKBOX</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_approver_count">
      <label>Number of Approvers</label>
      <fieldtype>INTEGER</fieldtype>
      <ismandatory>T</ismandatory>
      <defaultvalue>1</defaultvalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_use_amount">
      <label>Use Amount Thresholds</label>
      <fieldtype>CHECKBOX</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_default_approver1">
      <label>Default Approver 1</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <ismandatory>T</ismandatory>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_default_approver2">
      <label>Default Approver 2</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <ismandatory>F</ismandatory>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_approve_string">
      <label>Approve Button Label</label>
      <fieldtype>TEXT</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultvalue>Approve</defaultvalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_reject_string">
      <label>Reject Button Label</label>
      <fieldtype>TEXT</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultvalue>Reject</defaultvalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_email_enabled">
      <label>Enable Email Approval</label>
      <fieldtype>CHECKBOX</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_token_expiry_days">
      <label>Token Expiry (days)</label>
      <fieldtype>INTEGER</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultvalue>7</defaultvalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_email_sender">
      <label>Email Sender (From)</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <ismandatory>F</ismandatory>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_email_subject">
      <label>Email Subject</label>
      <fieldtype>TEXT</fieldtype>
      <ismandatory>F</ismandatory>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_email_intro">
      <label>Email Intro Text</label>
      <fieldtype>TEXTAREA</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultvalue>A new {recordType} from {subsidiary} has been entered in NetSuite and requires your approval. Please see the attached document for full details.</defaultvalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_oa_approve_without_login">
      <label>Approve Without Login</label>
      <fieldtype>CHECKBOX</fieldtype>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
    </customrecordcustomfield>
  </customrecordcustomfields>
</customrecordtype>
