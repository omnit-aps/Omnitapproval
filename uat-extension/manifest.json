{
  "manifest_version": 3,
  "name": "OmnitApprovals UAT Runner",
  "version": "1.0.0",
  "description": "Interactive UAT checklist for OmnitApprovals NetSuite bundle — 73 scenarios across 16 categories.",
  "action": {
    "default_title": "OmnitApprovals UAT"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
